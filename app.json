{
  "expo": {
    "name": "Plainworth",
    "slug": "plainworth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plainworth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gamequarry.plainworth",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gamequarry.plainworth",
      "adaptiveIcon": {
        "backgroundColor": "#111214",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Plainworth uses Face ID to keep your finances private."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111214",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "sourceCodeUrl": "https://github.com/gamequarryllc/plainworth",
      "revenueCatAppleKey": "appl_qGFwdKpJJlvREaRayGbbpTDRjYV",
      "revenueCatGoogleKey": "",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "77d40204-4024-4e83-87d9-2d4f399fb4ee"
      }
    },
    "owner": "appkingmaker"
  }
}
